# Vite content-hashes /assets; Showdown sprite artwork never changes and the
# item-icon sheet is content-hashed. season-bundle.json and itemicons.json
# stay on the platform default (etag revalidation) because they move between
# season exports.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/sprites/*
  Cache-Control: public, max-age=31536000, immutable
/logos/*
  Cache-Control: public, max-age=604800
