{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-draft-league",
  "compatibility_date": "2026-08-18",
  // The site lives only on the custom domain; keep deploys from re-enabling
  // the workers.dev subdomain.
  "workers_dev": false,
  "routes": [
    { "pattern": "aidraftleague.com", "custom_domain": true },
    { "pattern": "www.aidraftleague.com", "custom_domain": true },
  ],
  // Assets-only Worker: no script is deployed, so asset requests are free and
  // unlimited and nothing else is billable. SPA fallback serves index.html for
  // client-side routes that do not match a file.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
