{
  "name": "league",
  "version": "0.1.0",
  "private": true,
  "description": "Operator harness for language-model decisions across VGC drafts and battles",
  "bin": {
    "vgcleague": "dist/src/cli.js"
  },
  "type": "module",
  "exports": {
    "./protocol": {
      "types": "./dist/src/public/index.d.ts",
      "default": "./dist/src/public/index.js"
    },
    "./server": {
      "types": "./dist/src/server-entry.d.ts",
      "default": "./dist/src/server-entry.js"
    }
  },
  "scripts": {
    "setup:showdown": "node tools/setup-showdown.mjs",
    "update:showdown": "node tools/setup-showdown.mjs --update",
    "check:showdown-update": "node tools/setup-showdown.mjs --update --check",
    "prebuild": "node tools/setup-showdown.mjs --check && pnpm run clean",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "check": "pnpm run check:comments",
    "check:comments": "node tools/check-comments.mjs",
    "typecheck": "node tools/setup-showdown.mjs --check && tsc -p tsconfig.json --noEmit",
    "export:season": "node dist/src/cli.js export-season",
    "test:unit": "node -e 'for (const d of [\"runs\", \"records\"]) require(\"node:fs\").mkdirSync(d, { recursive: true })' && vp test",
    "test": "pnpm run check && pnpm run test:unit",
    "archive-run": "node tools/archive-run.mjs",
    "vgcleague": "node --env-file-if-exists=.env dist/src/cli.js",
    "build-pool": "node dist/tools/build-pool.js",
    "build-event-pool": "node dist/tools/build-event-pool.js",
    "build-board": "node dist/tools/build-draft-board.js",
    "fetch-sprites": "node dist/tools/fetch-sprites.js",
    "capture-requests": "node dist/tools/capture-requests.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.49",
    "@ai-sdk/google": "4.0.63",
    "@ai-sdk/openai": "4.0.58",
    "@ai-sdk/openai-compatible": "3.0.43",
    "ai": "7.0.92",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/parser": "8.0.4",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vite-plus": "0.3.0"
  },
  "engines": {
    "node": ">=24.18.1 <25"
  }
}
